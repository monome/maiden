    "packageManager": {
      "name": "yarn",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "babel-eslint": "^10.1.0",
    "classname": "^0.0.0",
    "history": "^4.7.2",
    "immutable": "^3.8.2",
    "macaddress": "^0.2.9",
    "monaco-editor": "0.52.2",
    "monaco-emacs": "^0.3.0",
    "monaco-vim": "^0.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-linkify": "^0.2.2",
    "react-modal": "^3.8",
    "react-redux": "8.1.3",
    "react-split-pane": "^0.1.74",
    "react-tooltip": "^5",
    "react-treebeard": "^2.1.0",
    "redux": "4.2.1",
    "redux-thunk": "^2.2.0",
    "reselect": "^3.0.1",
    "vite-plugin-commonjs": "^0.10.4"
  },
  "scripts": {
    "start": "./gen-version.sh && MAIDEN_PROXY=http://norns.local vite dev",
    "start_local": "./gen-version.sh && vite dev",
