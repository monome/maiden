{
  "name": "maiden",
  "version": "0.6.0",
  "private": true,
  "homepage": "/maiden",
  "engines": {
    "node": "22"
  },
  "packageManager": "yarn@4.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "yarn",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "classname": "^0.0.0",
    "history": "^4.7.2",
    "immutable": "^3.8.2",
    "macaddress": "^0.2.9",
    "monaco-editor": "0.52.2",
    "monaco-emacs": "^0.3.0",
    "monaco-vim": "^0.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-modal": "^3.8",
    "react-redux": "9.2.0",
    "react-resizable-panels": "^4.24.3",
    "react-tooltip": "^5",
    "redux": "5.0.1",
    "redux-thunk": "3.1.0",
    "reselect": "^3.0.1",
    "vite-plugin-commonjs": "^0.10.4"
  },
  "scripts": {
    "start": "./gen-version.sh && MAIDEN_PROXY=http://norns.local vite dev",
    "start_local": "./gen-version.sh && vite dev",
    "build": "./gen-version.sh && vite build",
    "preview": "./gen-version.sh && MAIDEN_PROXY=http://norns.local vite preview",
    "test": "vitest",
    "lint": "prettier --check src",
    "format": "prettier --write src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@babel/core": "^7.4.5",
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@storybook/addon-links": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^31.0.1",
    "prettier": "^3.6.2",
    "storybook": "^10.6.8",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@napi-rs/wasm-runtime": "1.2.7"
  }
