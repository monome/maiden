  "homepage": "/maiden",
  "engines": {
    "node": "22.23.2"
  },
  "packageManager": "yarn@1.22.22",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "yarn",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "babel-eslint": "^10.1.0",
    "classname": "^0.0.0",
    "connected-react-router": "^6.5.2",
    "history": "^4.7.2",
    "immutable": "^3.8.2",
    "macaddress": "^0.2.9",
    "parse-filepath": "^1.0.2",
    "react": "^16.8",
    "react-ace": "^9.2.1",
    "react-audio-player": "^0.17.0",
    "react-dom": "^16.8",
    "react-linkify": "^0.2.2",
    "react-modal": "^3.8",
    "react-redux": "^6.0.0",
    "react-router": "^5.1.2",
    "react-spinners-kit": "^1.9.1",
    "react-split-pane": "^0.1.74",
    "react-tooltip": "^3.5.1",
    "react-treebeard": "^2.1.0",
    "reactjs-popup": "^1.3.2",
    "redux": "^3.7.2",
    "redux-thunk": "^2.2.0",
    "reselect": "^3.0.1",
    "vite-plugin-commonjs": "^0.10.4"
  },
  "scripts": {
    "start": "./gen-version.sh && MAIDEN_PROXY=norns vite dev",
    "start_local": "./gen-version.sh && MAIDEN_PROXY=local vite dev",
    "build": "./gen-version.sh && vite build",
    "preview": "./gen-version.sh && MAIDEN_PROXY=norns vite preview",
    "test": "vitest",
    "lint": "./node_modules/.bin/eslint --ext .js --ext .jsx src",
    "format": "yarn lint --fix",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook"
  },
  "devDependencies": {
    "@babel/core": "^7.4.5",
    "@storybook/addon-actions": "^5.0.11",
    "@storybook/addon-links": "^5.0.11",
    "@storybook/addons": "^5.0.11",
    "@storybook/react": "^5.0.11",
    "babel-loader": "^8.0.6",
    "eslint": "^4.19.1",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-config-prettier": "^2.10.0",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.0",
    "eslint-plugin-prettier": "^2.7.0",
    "eslint-plugin-react": "^7.12.0",
    "prettier": "1.12.1",
    "redux-devtools": "^3.4.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
